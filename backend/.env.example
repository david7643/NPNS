# 서버 설정
APP_ENV=development

# JWT 설정
SECRET_KEY=your-secret-key-here-change-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
ACCESS_TOKEN_EXPIRE_MINUTES=525600 # 525600 = 1년

# 데이터베이스
DATABASE_URL=sqlite+aiosqlite:///./drowsyguard.db

# 감지 모델: 비워두면 검증한 personal-ear-v1 배포 모델을 사용합니다.
# 상대 경로 기준은 backend/입니다. 기존 모델 복구: DROWSINESS_MODEL_DIR=ai_models
# DROWSINESS_MODEL_DIR=ai_models/released/personal-ear-v1
DROWSINESS_CAMERA_INDEX=0
