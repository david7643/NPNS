# 서버 설정
APP_ENV=development

# JWT 설정
SECRET_KEY=your-secret-key-here-change-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
ACCESS_TOKEN_EXPIRE_MINUTES=525600 # 525600 = 1년

# 데이터베이스
DATABASE_URL=sqlite+aiosqlite:///./drowsyguard.db

# 감지 모델: 비워두면 검증한 personal-ear-v1 배포 모델을 사용합니다.
# 상대 경로 기준은 backend/입니다. 기존 모델 복구: DROWSINESS_MODEL_DIR=ai_models
# DROWSINESS_MODEL_DIR=ai_models/released/personal-ear-v1
# Linux: 연결된 USB 웹캠 중 프레임 수신 가능한 장치를 자동 선택합니다.
# 여러 웹캠 중 하나를 지정하려면 숫자를 사용합니다 (예: 32 = /dev/video32).
# Windows: USB 웹캠에 해당하는 OpenCV 번호를 지정하세요 (예: 0 또는 1).
DROWSINESS_CAMERA_INDEX=auto

# 노트북 시연 창: 앱에서 감지 시작 시 실시간 영상·눈 위치·판정 상태 표시
# 화면 없는 서버에서는 false로 설정하세요.
DROWSINESS_PREVIEW_ENABLED=true

# 아두이노 경보기: 서버 PC의 장치 관리자에서 확인한 COM 번호. 비워두면 사용 안 함 (arduino/README.md)
# ARDUINO_PORT=COM3
